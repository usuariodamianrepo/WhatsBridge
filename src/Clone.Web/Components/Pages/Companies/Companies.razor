@page "/companies"
@rendermode InteractiveServer

@using Clone.DataAccess.Repositories.IRepository
@using Clone.Utility
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<Companies> Logger
@inject INotificationService NotificationService
@inject IUnitOfWork UnitOfWork

@attribute [Authorize(Roles = RD.RoleAdmin)]

<PageTitle>Companies</PageTitle>
<FluentDialogProvider />
<FluentLabel Size="@LabelSize.Large">Companies</FluentLabel>
<FluentMessageBarProvider Section="@MESSAGEBAR_SECTION" Margin="@Margin.Vertical2" />

<FluentKeyCode OnKeyDown="@KeyDownHandler">
    <FluentStack HorizontalGap="6px" Wrap="true">
        <FluentButton Title="Add" IconStart="@(new Icons.Regular.Size20.Add())" Appearance="ButtonAppearance.Default"
                      OnClick="@OnAddClicked"/>
        <FluentTextInput @bind-Value=_NameSearch Placeholder="Name" TextInputType="TextInputType.Search" Maxlength=10 AutoComplete="off" Autofocus="true" />
        <FluentButton Title="Search" IconStart="@(new Icons.Regular.Size20.DatabaseSearch())" Appearance="ButtonAppearance.Primary"
                      OnClick="@OnSearchClicked" Loading="@_SearchButtonLoading">Search</FluentButton>
    </FluentStack>
</FluentKeyCode>

<FluentMultiSplitter>

    <FluentMultiSplitterPane Size="50%">
        <FluentDataGrid @ref="_Grid" Items=@_Companies GridTemplateColumns="0.2fr 1.5fr 1.5fr 1.5fr 1fr 1fr 1fr 1fr">
            <ChildContent>
                <PropertyColumn Property="@(c => c.Id)" />
                <PropertyColumn Property="@(c => c.Name)" Sortable="true" />
                <PropertyColumn Property="@(c => c.StreetAddress)" />
                <PropertyColumn Property="@(c => c.City)" />
                <PropertyColumn Property="@(c => c.State)" />
                <PropertyColumn Property="@(c => c.PostalCode)" />
                <PropertyColumn Property="@(c => c.PhoneNumber)" />
                <TemplateColumn Title="Actions" Align="@DataGridCellAlignment.Center">
                    <FluentButton Title="Edit" Appearance="ButtonAppearance.Subtle" IconEnd="@(new Icons.Regular.Size20.Edit())" OnClick="@(() => OnEditClicked(context.Id))" />
                    <FluentButton Title="Details" Appearance="ButtonAppearance.Subtle" IconEnd="@(new Icons.Regular.Size20.TextDescription())" OnClick="@(() => OnDetailsClicked(context.Id))" />
                    <FluentButton Title="Delete" Appearance="ButtonAppearance.Subtle" IconEnd="@(new Icons.Regular.Size20.Delete().WithColor(Color.Error))" OnClick="@(() => OnDeleteClicked(context.Id))" />
                </TemplateColumn>
            </ChildContent>
            <EmptyContent>
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.Center" HorizontalGap="10">
                    <FluentIcon Value="@(new Icons.Filled.Size24.Crown())" Color="@Color.Primary" />
                    <div>Nothing to see here. Carry on!</div>
                </FluentStack>
            </EmptyContent>
        </FluentDataGrid>
    </FluentMultiSplitterPane>

    <FluentMultiSplitterPane Collapsed="_CollapsedContent" Size="25%">
        <FluentLabel Size="@LabelSize.Large">Content - Id: @(_Company?.Id)</FluentLabel>
        <FluentDivider />
        @if (_Company != null)
        {
            <EditForm Model="_Company" OnValidSubmit="@(async () => await OnSaveContentClicked())">
                <DataAnnotationsValidator />
                <FluentGrid Justify="JustifyContent.FlexStart" Spacing="1" Padding="3px">
                    <FluentGridItem Xs="12" Sm="12">
                        <FluentTextInput Label="Name" @bind-Value=_Company.Name Required="true" Maxlength=120 AutoComplete="off" />
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Sm="12">
                        <FluentTextInput Label="StreetAddress" @bind-Value=_Company.StreetAddress Maxlength=120 AutoComplete="off" />
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Sm="12">
                        <FluentTextInput Label="City" @bind-Value=_Company.City Maxlength=120 AutoComplete="off" />
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Sm="12">
                        <FluentTextInput Label="State" @bind-Value=_Company.State Maxlength=60 AutoComplete="off" />
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Sm="12">
                        <FluentTextInput Label="PostalCode" @bind-Value=_Company.PostalCode Maxlength=60 AutoComplete="off" />
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Sm="12">
                        <FluentTextInput Label="PhoneNumber" @bind-Value=_Company.PhoneNumber Maxlength=60 AutoComplete="off" />
                    </FluentGridItem>
                </FluentGrid>
                <FluentStack id="toolbar-footer" HorizontalGap="6px" Padding="3px">
                    <FluentButton Type="ButtonType.Submit" Title="Save" IconStart="@(new Icons.Regular.Size20.Save())" Appearance="ButtonAppearance.Primary">Save</FluentButton>
                    <FluentButton Title="Cancel" IconStart="@(new Icons.Regular.Size20.ArrowExit())" Appearance="ButtonAppearance.Default"
                                  OnClick="OnCancelContentClicked">Cancel</FluentButton>
                </FluentStack>
            </EditForm>
        }
        else
        {
            <p>No Company selected.</p>
        }
    </FluentMultiSplitterPane>

    <FluentMultiSplitterPane Collapsed="_CollapsedDetails" Size="25%">
        <FluentLabel Size="@LabelSize.Large">Details - Id: @(_CompaniesDetails?.Id)</FluentLabel>
        <FluentDivider />
        @if (_CompaniesDetails != null)
        {
            <FluentGrid Justify="JustifyContent.FlexStart" Spacing="1" Padding="3px">
                <FluentGridItem Xs="12" Sm="12">
                    <b>Name:</b> @(_CompaniesDetails.Name)
                </FluentGridItem>
                <FluentGridItem Xs="12" Sm="12">
                    <b>StreetAddress:</b> @(_CompaniesDetails.StreetAddress)
                </FluentGridItem>
                <FluentGridItem Xs="12" Sm="12">
                    <b>City:</b> @(_CompaniesDetails.City)
                </FluentGridItem>
                <FluentGridItem Xs="12" Sm="12">
                    <b>State:</b> @(_CompaniesDetails.State)
                </FluentGridItem>
                <FluentGridItem Xs="12" Sm="12">
                    <b>PostalCode:</b> @(_CompaniesDetails.PostalCode)
                </FluentGridItem>
                <FluentGridItem Xs="12" Sm="12">
                    <b>PhoneNumber:</b> @(_CompaniesDetails.PhoneNumber)
                </FluentGridItem>
                <FluentDivider AlignContent="DividerAlignContent.Center">
                    Audit Information
                </FluentDivider>
                <FluentGridItem Xs="12">
                    <b>InsertDate:</b> @(_CompaniesDetails.InsertDate.ConvertToShow().ToString("yyyy-MM-dd HH:mm:ss"))
                </FluentGridItem>
                <FluentGridItem Xs="12">
                    <b>InsertUser:</b> @(_CompaniesDetails.InsertUser)
                </FluentGridItem>
                <FluentGridItem Xs="12">
                    <b>UpdateDate:</b> @(_CompaniesDetails.UpdateDate?.ConvertToShow().ToString("yyyy-MM-dd HH:mm:ss"))
                </FluentGridItem>
                <FluentGridItem Xs="12">
                    <b>UpdateUser:</b> @(_CompaniesDetails.UpdateUser)
                </FluentGridItem>
            </FluentGrid>
            <br />
            <FluentStack id="toolbar-footer" HorizontalGap="6px">
                <FluentButton Title="Copy" IconStart="@(new Icons.Regular.Size20.Copy())" Appearance="ButtonAppearance.Default"
                              OnClick="OnCopyDetailsToClipboard">Copy</FluentButton>
                <FluentButton Title="Cancel" IconStart="@(new Icons.Regular.Size20.ArrowExit())" Appearance="ButtonAppearance.Default"
                              OnClick="OnCancelDetailsClicked">Cancel</FluentButton>
            </FluentStack>
        }
        else
        {
            <p>No Company selected.</p>
        }
    </FluentMultiSplitterPane>

</FluentMultiSplitter>
