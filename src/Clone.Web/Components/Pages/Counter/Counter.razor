@page "/counter"
@rendermode InteractiveServer
@using System.Globalization
@using Clone.Utility

<PageTitle>Counter</PageTitle>

<h1>Culture Example 1</h1>
<ul>
    <li><b>CurrentCulture</b>: @CultureInfo.CurrentCulture</li>
    <li><b>CurrentUICulture</b>: @CultureInfo.CurrentUICulture</li>
</ul>

<h2>Rendered values</h2>

<ul>
    <li><b>Date</b>: @dt</li>
    <li><b>Number</b>: @number.ToString("N2")</li>
</ul>

<h2><code>&lt;input&gt;</code> elements that don't set a <code>type</code></h2>

<p>
    The following <code>&lt;input&gt;</code> elements use
    <code>CultureInfo.CurrentCulture</code>.
</p>

<ul>
    <li><label><b>Date:</b> <input @bind="dt" /></label></li>
    <li><label><b>Number:</b> <input @bind="number" /></label></li>
</ul>

<h2><code>&lt;input&gt;</code> elements that set a <code>type</code></h2>

<p>
    The following <code>&lt;input&gt;</code> elements use
    <code>CultureInfo.InvariantCulture</code>.
</p>

<ul>
    <li><label><b>Date:</b> <input type="date" @bind="dt" /></label></li>
    <li><label><b>Number:</b> <input type="number" @bind="number" /></label></li>
</ul>

<h1>Counter</h1>

<div role="status" style="display: flex; align-items: center; gap: 12px; padding-bottom: 1em;">
    Current count: <FluentBadge Shape="BadgeShape.Rounded" Content="@($"{currentCount}")" />
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@OnIncrementCountClicked">Click me</FluentButton>
</div>
<div role="status" style="display: flex; align-items: center; gap: 12px; padding-bottom: 1em;">
    Token Generate: <code>@($"{token}")</code>
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@OnTokenGenerateClicked">Token Generate</FluentButton>
</div>
<div role="status" style="display: flex; align-items: center; gap: 12px; padding-bottom: 1em;">
    Token Generate: <code>@($"{tokenHash}")</code>
    <FluentButton Appearance="ButtonAppearance.Default" OnClick="@OnTokenHashClicked">Token Hash</FluentButton>
</div>

@code {
    private int currentCount = 0;
    private DateTime dt = DateTime.Now;
    private double number = 1999.69;
    string token = string.Empty;
    string tokenHash = string.Empty;

    private async Task OnIncrementCountClicked()
    {
        currentCount++;
    }

    private async Task OnTokenGenerateClicked()
    {
        await Task.Delay(1000);
        token = Tools.TokenGenerate();
    }

    private async Task OnTokenHashClicked()
    {
        await Task.Delay(1000);
        tokenHash = Tools.TokenHash(token);
    }
}
